{
  "name": "shortrace-analytics-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check:app": "svelte-check --tsconfig ./tsconfig.app.json",
    "check:node": "tsc -p tsconfig.node.json",
    "check": "run-s check:app check:node",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "lint": "eslint .",
	"validate": "run-s check lint test:cov",
    "format": "prettier --write \"src/**/*.{svelte,ts,css,html}\"",
	"tf:init": "terraform -chdir=terraform init",
    "tf:plan": "terraform -chdir=terraform plan",
    "tf:apply": "terraform -chdir=terraform apply -auto-approve",
    "tf:destroy": "terraform -chdir=terraform destroy",
    "tf:output": "terraform -chdir=terraform output",
	"compile:init": "run-s tf:init tf:apply tf:output",
	"compile": "run-s tf:apply tf:output",
	"deploy:s3": "aws s3 sync dist/ s3://$S3_BUCKET_NAME/ --delete --cache-control max-age=86400",
    "deploy:invalidate": "aws cloudfront create-invalidation --distribution-id $CLOUDFRONT_DISTRIBUTION_ID --paths \"/*\"",
    "deploy": "run-s build deploy:s3 deploy:invalidate"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/postcss": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.12.3",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "@vitest/coverage-v8": "^4.1.6",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.4.0",
    "eslint-plugin-svelte": "^3.17.1",
    "jsdom": "^29.1.1",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.15",
    "prettier": "^3.8.3",
    "prettier-plugin-svelte": "^3.5.2",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "svelte": "^5.55.5",
    "svelte-check": "^4.4.8",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.4",
    "vite": "^8.0.12",
    "vitest": "^4.1.6"
  },
  "dependencies": {
    "axios": "^1.16.1",
    "chart.js": "^4.5.1"
  }
}
